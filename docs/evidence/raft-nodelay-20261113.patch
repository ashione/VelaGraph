+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[ignore = "controlled original-tree nodelay experiment"]
+async fn investigate_fresh_quorum_latency() -> anyhow::Result<()> {
+    let cluster = Cluster::start().await?;
+    let mut samples = Vec::new();
+    for _ in 0..100 {
+        let started = std::time::Instant::now();
+        let d = remote::open_snapshot(cluster.tcp(), Some(cluster.identity()), SHARD, BUDGET).await?;
+        samples.push(started.elapsed().as_micros());
+        remote::close_snapshot(cluster.tcp(), Some(cluster.identity()), d, BUDGET).await?;
+    }
+    eprintln!("QUORUM_LATENCY_US={samples:?}");
+    Ok(())
+}
